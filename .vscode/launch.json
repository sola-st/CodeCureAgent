    "version": "0.2.0",
    "configurations": [
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash-Debug run_on_dataset.sh",
            "cwd": "/workspaces/master-thesis-pascal-joos/",
            "program": "repair_agent/run_on_dataset.sh",
            "args": []
        },
        {
            "type": "bashdb",
            "request": "launch",
            "name": "Bash-Debug (select script from list of sh files)",
            "cwd": "/workspaces/master-thesis-pascal-joos/repair_agent/",
            "program": "${command:SelectScriptName}",
            "args": []
        },       
        

        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "CodeGenerator",
            "request": "launch",
            "mainClass": "sorald.CodeGenerator",
            "projectName": "sorald"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "sorald.Main",
            "projectName": "sorald"
        },
        {
            "type": "java",
            "name": "Mine example",
            "request": "launch",
            "mainClass": "sorald.Main",
            "projectName": "sorald",
            "args": "mine --source ./repair_agent/sorald --stats-output-file ./repair_agent/logs/mining_debug_result.json --temp-dir /tmp/testsorald --handled-rules"
        },
        {
            "type": "java",
            "name": "Mine Repos Old Commit",
            "request": "launch",
            "mainClass": "sorald.Main",
            "projectName": "sorald",
            "args": "mine --git-repos-list ./repair_agent/experimental_setups/dev_dataset/sampled_repos_specific_commit.txt --miner-output-file ./repair_agent/logs/out_handled_rules_test.txt --stats-output-file ./repair_agent/logs/mined_result_handled_rules_test.json  --temp-dir ./repair_agent/experimental_setups/dev_dataset/temp --stats-on-git-repos --handled-rules"
        },
        {
            "type": "java",
            "name": "Mine Repos Current",
            "request": "launch",
            "mainClass": "sorald.Main",
            "projectName": "sorald",
            "args": "mine --git-repos-list ./repair_agent/experimental_setups/dev_dataset/sampled_repos.txt --miner-output-file ./repair_agent/logs/out_handled_rules_test.txt --stats-output-file ./repair_agent/logs/mined_result_handled_rules_test.json  --temp-dir ./repair_agent/experimental_setups/dev_dataset/temp --stats-on-git-repos --handled-rules"
        },
        {
            "type": "java",
            "name": "StatsOutputAnalyzer",
            "request": "launch",
            "mainClass": "sorald.miner.StatsOutputAnalyzer",
            "projectName": "sorald"
        }
    ]
}