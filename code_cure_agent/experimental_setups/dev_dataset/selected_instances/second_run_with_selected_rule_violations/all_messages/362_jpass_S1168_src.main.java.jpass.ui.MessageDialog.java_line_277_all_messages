                ]
            },
            {
                "line_number": 180,
                "new_lines": [
                    "    // ... additional new lines ...\n"
                ]
            }
        ],
        "deletions": [179, 183]
    },
    // changes in file 2
    {
        "file_name": "org/jfree/data/time/Day.java",
