    // changes in file 1
    {
        "file_name": "org/jfree/data/time/Week.java",
        "insertions": [
            {
                "line_number": 175,
                "new_lines": [
                    "    // ... new lines to insert ...\n",
                    "    // ... more new lines ...\n"
                ]
            },
            {
                "line_number": 180,
                "new_lines": [
                    "    // ... additional new lines ...\n"
                ]
            }
