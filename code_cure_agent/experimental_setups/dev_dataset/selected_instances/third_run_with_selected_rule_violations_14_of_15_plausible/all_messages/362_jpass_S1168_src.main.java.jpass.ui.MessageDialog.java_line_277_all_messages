    }
    
    public static Map<String, Object> getValues() {
      return Collections.emptyMap();           // Compliant
    }
    
    public static void main(String[] args) {
      for (Result result: getAllResults()) {
        /* ... */
      }
    
      for (Result result: getResults()) {
        /* ... */
