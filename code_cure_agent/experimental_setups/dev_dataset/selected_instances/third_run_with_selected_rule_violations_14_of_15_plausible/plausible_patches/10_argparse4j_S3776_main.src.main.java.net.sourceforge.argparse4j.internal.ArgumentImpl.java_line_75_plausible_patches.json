                    "    // Helper method to validate nameOrFlags and mutex condition",
                    "    private void validateNameOrFlags(String[] nameOrFlags, ArgumentGroupImpl argumentGroup) {",
                    "        if (nameOrFlags.length == 0) {",
                    "            throw new IllegalArgumentException(\"no nameOrFlags was specified\");",
                    "        }",
                    "        if (nameOrFlags.length == 1 && argumentGroup != null && argumentGroup.isMutex()) {",
                    "            throw new IllegalArgumentException(\"mutually exclusive arguments must be optional\");",
                    "        }",
                    "    }",
                    "",
                    "    // Helper method to handle positional argument initialization",
                    "    private void handlePositionalArgument(ArgumentParserConfigurationImpl config, String nameOrFlag) {",
                    "        name_ = nameOrFlag;",
                    "        if (!config.noDestConversionForPositionalArgs_) {",
                    "            dest_ = name_.replace('-', '_');",
                    "        }",
                    "    }",
                    "",
                    "    // Helper method to handle optional arguments initialization and validation",
                    "    private void handleOptionalArguments(ArgumentParserConfigurationImpl config, String[] nameOrFlags) {",
                    "        flags_ = nameOrFlags;",
                    "        for (String flag : flags_) {",
                    "            if (!config.prefixPattern_.match(flag)) {",
                    "                throw new IllegalArgumentException(",
                    "                        String.format(",
                    "                                TextHelper.LOCALE_ROOT,",
                    "                                localize(\"invalidOptionStringError\"),",
                    "                                flag, config.prefixPattern_.getPrefixChars()));",
                    "            }",
                    "        }",
                    "        boolean shouldBreak = false;",
                    "        for (String flag : flags_) {",
                    "            boolean longFlag = config.prefixPattern_.matchLongFlag(flag);",
                    "            if (dest_ == null) {",
                    "                dest_ = flag;",
                    "                if (longFlag) {",
                    "                    shouldBreak = true;",
                    "                }",
                    "            } else if (longFlag) {",
                    "                dest_ = flag;",
                    "                shouldBreak = true;",
                    "            }",
                    "            if (shouldBreak) {",
                    "                break;",
                    "            }",
                    "        }",
                    "        dest_ = config.prefixPattern_.removePrefix(dest_).replace('-', '_');",
                    "    }"
