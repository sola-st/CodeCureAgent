                "line_number": 10,
                "new_lines": [
                    "    int x = 5;",
                    "    System.out.println(x);"
                ]
            }
        ],
        "deletions": [12, 13]
    },
    {
        "file_name": "src/main/File2.java",
        "insertions": [],
        "deletions": [20]
    }
]
```

