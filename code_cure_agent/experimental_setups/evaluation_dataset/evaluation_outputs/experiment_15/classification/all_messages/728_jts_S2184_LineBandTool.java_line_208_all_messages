    long bigNum = Integer.MAX_VALUE + 2L; // 2 promoted to long. Yields 2_147_483_649
    long bigNegNum =  Integer.MIN_VALUE-1L; // Yields -2_147_483_649
    Date myDate = new Date(seconds * 1_000L);
