    tempDir = File.createTempFile("", ".");
    tempDir.delete();
    tempDir.mkdir();  // Noncompliant
    

Compliant Solution
    
    
    Path tempPath = Files.createTempDirectory("");
    File tempDir = tempPath.toFile();
    

