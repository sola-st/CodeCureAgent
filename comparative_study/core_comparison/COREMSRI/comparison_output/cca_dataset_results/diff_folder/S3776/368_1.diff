+// Helper methods to reduce cognitive complexity
+private static boolean checkNextSegment(SegmentIteratorImpl segIterB, Segment segmentA, double[] scalarsA, double lengthA, double length, double tolerance) {
+	segmentB = segIterB.nextSegment();
+	int result = segmentA.intersect(segmentB, null, scalarsA, null, tolerance);
+
+	if (result == 2) {
+		double nextScalarA0 = scalarsA[0];
+		double nextScalarA1 = scalarsA[1];
+
+		double lengthNext = lengthA * (nextScalarA1 - nextScalarA0);
+
+		if (length + lengthNext > tolerance) {
+			return true;
+		}
+	}
+
+	segIterB.resetToVertex(segIterB.getStartPointIndex());
+	segIterB.nextSegment();
+
+	return false;
+}
+
+private static boolean checkPreviousSegment(SegmentIteratorImpl segIterB, Segment segmentA, double[] scalarsA, double lengthA, double length, double tolerance) {
+	segIterB.previousSegment();
+	segmentB = segIterB.previousSegment();
+	int result = segmentA.intersect(segmentB, null, scalarsA, null, tolerance);
+
+	if (result == 2) {
+		double nextScalarA0 = scalarsA[0];
+		double nextScalarA1 = scalarsA[1];
+
+		double lengthPrevious = lengthA * (nextScalarA1 - nextScalarA0);
+
+		if (length + lengthPrevious > tolerance) {
+			return true;
+		}
+	}
+
+	segIterB.resetToVertex(segIterB.getStartPointIndex());
+	segIterB.nextSegment();
+
+	return false;
+}
