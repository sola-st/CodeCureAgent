        }
        System.out.println(matrix[row][col]);                // Prints the elements under the diagonal, i.e. 4, 7 and 8
      }
    }
    

Compliant Solution
    
    
    for (int row = 1; row < matrix.length; row++) {          // Compliant
      for (int col = 0; col < row; col++) {
