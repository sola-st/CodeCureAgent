      ...
    }
    

Compliant Solution
    
    
    public void doSomething(int myParam) {
      int local;
      ...
    }
    

Exceptions

Loop counters are ignored by this rule.
    
    
    for (int i_1 = 0; i_1 < limit; i_1++) {  // Compliant
      // ...
    }
    

