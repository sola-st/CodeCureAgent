    java.util.Logger logger;
    logger.log(java.util.logging.Level.SEVERE, "Result {0}.", myObject);
    logger.log(java.util.logging.Level.SEVERE, "Result {0}'", 14);
    logger.log(java.util.logging.Level.SEVERE, exception, () -> "Result " + param);
    
