+/**
+ * A helper class to wrap logger as an OutputStream for PrintWriter
+ */
+class LoggerOutputStream extends java.io.OutputStream {
+  private final org.slf4j.Logger logger;
+  private final boolean isInfo;
+  private final java.io.ByteArrayOutputStream buffer = new java.io.ByteArrayOutputStream();
+
+  public LoggerOutputStream(org.slf4j.Logger logger, boolean isInfo) {
+    this.logger = logger;
+    this.isInfo = isInfo;
+  }
+
+  @Override
+  public void write(int b) {
+    if (b == '\n') {
+      flushBuffer();
+    } else {
+      buffer.write(b);
+    }
+  }
+
+  @Override
+  public void flush() {
+    flushBuffer();
+  }
+
+  private void flushBuffer() {
+    if (buffer.size() > 0) {
+      String message = buffer.toString();
+      if (isInfo) {
+        logger.info(message);
+      } else {
+        logger.error(message);
+      }
+      buffer.reset();
+    }
+  }
+}
