+    private static class SerializableType implements Serializable {
+        private static final long serialVersionUID = 1L;
+        private transient Type type;
+        private final String typeClassName;
+
+        SerializableType(Type type) {
+            this.type = type;
+            this.typeClassName = type.getClass().getName();
+            // We only store the full class name, since Type is often not serializable.
+        }
+
+        public Type getType() {
+            if (type == null) {
+                try {
+                    Class<?> cls = Class.forName(typeClassName);
+                    type = cls;
+                } catch (ClassNotFoundException e) {
+                    throw new IllegalStateException("Failed to deserialize Type class " + typeClassName, e);
+                }
