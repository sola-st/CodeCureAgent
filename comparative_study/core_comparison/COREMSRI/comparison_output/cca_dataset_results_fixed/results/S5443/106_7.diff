+    /**
+     * Create a secure temporary directory with restricted permissions.
+     * This method ensures the temporary directory is not created in a publicly writable directory with predictable names.
+     * 
+     * @return File representing the secure temporary directory
+     * @throws IOException if an error occurs during creation
+     */
+    private static File createSecureTempDirectory() throws IOException {
+        // Create temp directory using secure API with restricted permissions
+        FileAttribute<Set<PosixFilePermission>> attr = PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------"));
+        File dir;
+        try {
+            dir = Files.createTempDirectory("tmp", attr).toFile();
+        } catch (UnsupportedOperationException e) {
+            // Fallback for non-POSIX systems
+            dir = Files.createTempDirectory("tmp").toFile();
+            dir.setReadable(true, true);
+            dir.setWritable(true, true);
+            dir.setExecutable(true, true);
+        }
+        return dir;
+    }
+
